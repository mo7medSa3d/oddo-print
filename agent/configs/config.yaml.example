server:
  # Production gateways MUST use HTTPS. Plain HTTP is rejected unless the
  # process is explicitly started for an isolated development/test environment
  # with YASEIR_AGENT_ALLOW_INSECURE_HTTP=1. Never enable that setting in a
  # production service.
  url: "https://your-print-gateway.example.com"

agent:
  id: ""
  secret: ""
  name: "Main Office Agent"
  # Safe default: false prevents silent duplicate physical output after a crash.
  # Set true only when the business accepts at-least-once reprinting.
  reprint_after_crash: false

printers:
  - id: "printer_kitchen"
    name: "Kitchen Printer"
    type: "network"
    endpoint: "192.168.1.50:9100"
    protocol: "escpos"
  
  # USB printers can be represented through the Windows spooler backend when a
  # local Windows queue is available. Direct raw USB is intentionally not used
  # as a network transport.
  - id: "printer_receipt"
    name: "Front Desk Printer"
    type: "network"
    endpoint: "192.168.1.51:9100"
    protocol: "raw"

  # Windows OS spooler printer example (A4 reports, laser, USB thermal via driver):
  # - id: "printer_office_a4"
  #   name: "Office Laser Printer"
  #   type: "spooler"
  #   connection_type: "spooler"
  #   printer_type: "laser"
  #   spooler_name: "HP LaserJet Pro MFP"
  #   protocol: "windows_spooler"
  #   enabled: true

  # Safe service-backed virtual capture (TEST-ONLY, OFF by default):
  # Requires service environment YASEIR_AGENT_VIRTUAL_TEST_MODE=1 AND
  # Gateway environment YASEIR_GATEWAY_VIRTUAL_TEST_MODE=1, followed by
  # service/container restart. The Agent service writes *files*, not paper.
  # - id: "yaseir_virtual_capture"
  #   name: "Yaseir Test File Capture"
  #   type: "spooler"
  #   connection_type: "spooler"
  #   printer_type: "virtual"
  #   spooler_name: "YASEIR_VIRTUAL_TEST_CAPTURE"
  #   protocol: "spooler"
  #   capabilities:
  #     virtual_test_sink: true
  #     supported_protocols: ["pdf", "image", "raw", "escpos"]
  #   enabled: true
  #
  # Test files go under C:\\ProgramData\\YaseirAgent\\VirtualTestPrints
  # (or YASEIR_AGENT_VIRTUAL_TEST_OUTPUT_DIR on an absolute, secured local
  # path). Never set this for a customer's live billing/receipt workload;
  # only synthetic diagnostic Test Print jobs are admitted by the Gateway.
