+  attempt_id TEXT,
+  claim_id TEXT,
+  spooler_job_id TEXT,
+  agent_id TEXT,
+  printer_id TEXT,
+  request_id TEXT,
+  message TEXT,
+  error_code TEXT,
+  metadata JSONB NOT NULL DEFAULT '{}'::jsonb,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
