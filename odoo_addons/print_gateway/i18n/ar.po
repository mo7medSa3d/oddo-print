#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Odoo Branch must belong directly to the selected Odoo Company."
msgstr "يجب أن يتبع فرع Odoo شركة Odoo المحددة مباشرةً."

#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Odoo Branch must be a child Branch, not the selected root Company."
msgstr "يجب أن يكون فرع Odoo فرعًا تابعًا، لا الشركة الجذر المحددة."

#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Gateway agent discovery failed (HTTP %s)."
msgstr "تعذّر اكتشاف الـ Agents في الـ Gateway (HTTP %s)."

#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Gateway agent discovery is unavailable."
msgstr "اكتشاف الـ Agents في الـ Gateway غير متاح."

#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Gateway returned an invalid agent discovery response."
msgstr "أعاد الـ Gateway استجابة غير صالحة لاكتشاف الـ Agents."

#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Gateway printer discovery failed (HTTP %s)."
msgstr "تعذّر اكتشاف الطابعات في الـ Gateway (HTTP %s)."

#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Gateway printer discovery is unavailable."
msgstr "اكتشاف الطابعات في الـ Gateway غير متاح."

#. module: print_gateway
#: controllers/runtime_printers.py
msgid "Gateway returned an invalid printer discovery response."
msgstr "أعاد الـ Gateway استجابة غير صالحة لاكتشاف الطابعات."

#. module: print_gateway
#: models/binding.py
msgid "The requested report is unavailable."
msgstr "التقرير المطلوب غير متاح."

#. module: print_gateway
#: models/binding.py
msgid "Only QWeb PDF reports can be sent to the Print Gateway."
msgstr "يمكن إرسال تقارير QWeb PDF فقط إلى الـ Gateway."

#. module: print_gateway
#: models/binding.py
msgid "You are not allowed to view or use this report."
msgstr "لا يحق لك عرض هذا التقرير أو استخدامه."

#. module: print_gateway
#: models/binding.py
msgid "A Print Binding cannot use itself as its failover target."
msgstr "لا يمكن لربط الطباعة أن يستخدم نفسه كوجهة تجاوز فشل."

#. module: print_gateway
#: models/binding.py
msgid "The failover binding must use the same Odoo Company and Branch as the primary binding."
msgstr "يجب أن يستخدم ربط تجاوز الفشل شركة Odoo وفرعها نفسهما المستخدمين في الربط الأساسي."

#. module: print_gateway
#: models/binding.py
msgid "The failover binding must target the same destination as the primary binding."
msgstr "يجب أن يستهدف ربط تجاوز الفشل الوجهة نفسها التي يستهدفها الربط الأساسي."

#. module: print_gateway
#: models/binding.py
msgid "The failover binding must use the same document type as the primary binding."
msgstr "يجب أن يستخدم ربط تجاوز الفشل نوع المستند نفسه المستخدم في الربط الأساسي."

#. module: print_gateway
#: models/binding.py
msgid "An enabled Print Gateway configuration is required for this Odoo Company."
msgstr "يلزم إعداد Gateway طباعة مُفعّل لهذه الشركة في Odoo."

#. module: print_gateway
#: models/binding.py
msgid "The selected Gateway Runtime Agent is not assigned to the current Odoo Branch."
msgstr "الـ Agent المحدَّد غير مُعيَّن لفرع Odoo الحالي."

#. module: print_gateway
#: models/binding.py
msgid "Gateway runtime agent discovery is unavailable."
msgstr "اكتشاف الـ Agents في الـ Gateway غير متاح."

#. module: print_gateway
#: models/binding.py
msgid "The selected Gateway Runtime Agent is not found."
msgstr "الـ Agent المحدَّد غير موجود."

#. module: print_gateway
#: models/binding.py
msgid "Agent '%s' cannot be assigned because its lifecycle is '%s'. Only agents with lifecycle 'active' may receive print jobs."
msgstr "لا يمكن تعيين الـ Agent '%s' لأن دورة حياته '%s'. يمكن فقط للـ Agents التي تكون دورة حياتها 'active' تلقّي مهام الطباعة."

#. module: print_gateway
#: models/binding.py
msgid "Gateway runtime printer discovery is unavailable."
msgstr "اكتشاف طابعات الـ Gateway غير متاح."

#. module: print_gateway
#: models/binding.py
msgid "The selected Gateway Runtime Printer is not found."
msgstr "طابعة الـ Gateway المحدَّدة غير موجودة."

#. module: print_gateway
#: models/binding.py
msgid "Printer '%s' cannot be assigned because its lifecycle is '%s'. Only printers with lifecycle 'active' may receive print jobs."
msgstr "لا يمكن تعيين الطابعة '%s' لأن دورة حياتها '%s'. يمكن فقط للطابعات التي تكون دورة حياتها 'active' تلقّي مهام الطباعة."

#. module: print_gateway
#: models/binding.py
msgid "Gateway Runtime Printer does not belong to the selected Runtime Agent."
msgstr "طابعة الـ Gateway لا تتبع الـ Agent المحدَّد."

#. module: print_gateway
#: models/binding.py
msgid "POS receipts require a thermal receipt printer, not a document/laser printer."
msgstr "إيصالات POS تتطلب طابعة إيصالات حرارية، لا طابعة مستندات أو ليزر."

#. module: print_gateway
#: models/binding.py
msgid "POS Kitchen / Preparation printing requires a thermal printer, not a document/laser printer."
msgstr "طباعة مطبخ POS / التحضير تتطلب طابعة حرارية، لا طابعة مستندات أو ليزر."

#. module: print_gateway
#: models/binding.py
msgid "Direct inventory/warehouse operations require a label or thermal printer."
msgstr "عمليات المخزون/المستودع المباشرة تتطلب طابعة ملصقات أو طابعة حرارية."

#. module: print_gateway
#: models/binding.py
msgid "Odoo Company must be a root Company, not a Branch."
msgstr "يجب أن تكون شركة Odoo شركة جذر، لا فرعًا."

#. module: print_gateway
#: models/binding.py
msgid "The selected Odoo Company is not available to the current user."
msgstr "شركة Odoo المحدَّدة غير متاحة للمستخدم الحالي."

#. module: print_gateway
#: models/binding.py
msgid "Odoo Branch is not available to the current user."
msgstr "فرع Odoo غير متاح للمستخدم الحالي."

#. module: print_gateway
#: models/binding.py
msgid "A Gateway Runtime Agent is required for a branch binding."
msgstr "يلزم وجود Agent للـ Gateway عند الربط على مستوى الفرع."

#. module: print_gateway
#: models/binding.py
msgid "Gateway Runtime Agent '%s' is not explicitly assigned to '%s'. Assign the Agent to this exact Odoo scope before creating the binding."
msgstr "الـ Agent '%s' غير مُعيَّن صراحةً إلى '%s'. عيّن الـ Agent على نطاق Odoo هذا تحديدًا قبل إنشاء الربط."

#. module: print_gateway
#: models/binding.py
msgid "A valid Odoo Destination is required."
msgstr "يلزم تحديد وجهة صالحة في Odoo."

#. module: print_gateway
#: models/binding.py
msgid "Odoo Destination belongs to another company/branch context."
msgstr "وجهة Odoo تتبع سياق شركة/فرع آخر."

#. module: print_gateway
#: models/binding.py
msgid "Document / Report belongs to another company/branch context."
msgstr "المستند/التقرير يتبع سياق شركة/فرع آخر."

#. module: print_gateway
#: models/binding.py
msgid "A POS Shop is required for a POS Receipt binding."
msgstr "يلزم تحديد متجر POS لربط إيصالات POS."

#. module: print_gateway
#: models/binding.py
msgid "POS Receipt bindings must not select an Odoo Kitchen Printer."
msgstr "يجب ألا تختار روابط إيصالات POS طابعة مطبخ في Odoo."

#. module: print_gateway
#: models/binding.py
msgid "POS Receipt bindings must not select an Odoo Report; the receipt is rendered by the POS client."
msgstr "يجب ألا تختار روابط إيصالات POS تقريرًا في Odoo؛ فعميل POS هو مَن يُنشئ الإيصال."

#. module: print_gateway
#: models/binding.py
msgid "An Odoo Preparation Printer or POS Shop is required for a POS Kitchen / Preparation binding."
msgstr "يلزم تحديد طابعة تحضير في Odoo أو متجر POS لربط مطبخ POS / التحضير."

#. module: print_gateway
#: models/binding.py
msgid "Odoo Preparation Printer must belong to an Odoo POS Preparation Printer configuration."
msgstr "يجب أن تتبع طابعة التحضير في Odoo إعداد طابعة تحضير POS في Odoo."

#. module: print_gateway
#: models/binding.py
msgid "Odoo Preparation Printer is not available to the selected Odoo Branch."
msgstr "طابعة التحضير في Odoo غير متاحة لفرع Odoo المحدَّد."

#. module: print_gateway
#: models/binding.py
msgid "POS Kitchen / Preparation bindings must not select an Odoo Report."
msgstr "يجب ألا تختار روابط مطبخ POS / التحضير تقريرًا في Odoo."

#. module: print_gateway
#: models/binding.py
msgid "A Report must be selected for this Destination Type."
msgstr "يجب اختيار تقرير لهذا النوع من الوجهات."

#. module: print_gateway
#: models/binding.py
msgid "Report destination and report document must be the same record."
msgstr "يجب أن تكون وجهة التقرير ومستند التقرير السجل نفسه."

#. module: print_gateway
#: models/binding.py
msgid "A real Odoo report must be selected for this Destination Type."
msgstr "يجب اختيار تقرير حقيقي من Odoo لهذا النوع من الوجهات."

#. module: print_gateway
#: models/binding.py
msgid "POS receipts must use a POS or report destination."
msgstr "يجب أن تستخدم إيصالات POS وجهة من نوع POS أو تقرير."

#. module: print_gateway
#: models/binding.py
msgid "Stock reports must use an operation type or report destination."
msgstr "يجب أن تستخدم تقارير المخزون وجهة من نوع عملية أو تقرير."

#. module: print_gateway
#: models/binding.py
msgid "A Gateway Runtime Printer must be selected."
msgstr "يجب اختيار طابعة من طابعات الـ Gateway."

#. module: print_gateway
#: models/binding.py
msgid "Only Odoo system administrators can dispatch test pages."
msgstr "يمكن لمسؤولي نظام Odoo فقط إرسال صفحات الاختبار."

#. module: print_gateway
#: models/binding.py
msgid "Test Print Dispatched"
msgstr "تم إرسال الطباعة التجريبية"

#. module: print_gateway
#: models/binding.py
msgid "Diagnostic test page sent to printer '%s'."
msgstr "تم إرسال صفحة الاختبار التشخيصية إلى الطابعة '%s'."

#. module: print_gateway
#: models/binding.py
msgid "Only Odoo system administrators can validate hardware registration."
msgstr "يمكن لمسؤولي نظام Odoo فقط اعتماد تسجيل الأجهزة."

#. module: print_gateway
#: models/binding.py
msgid "Registration Validated"
msgstr "تم اعتماد التسجيل"

#. module: print_gateway
#: models/binding.py
msgid "Gateway registration is consistent: agent '%s' and printer '%s' are registered and active. This is a control-plane check, not a live hardware test - use Send Test Page to validate the physical path."
msgstr "تسجيل الـ Gateway متسق: الـ Agent '%s' والطابعة '%s' مُسجَّلان ونشطان. هذا فحص على مستوى الإدارة، وليس اختبارًا فعليًا للأجهزة — استخدم «إرسال صفحة اختبار» للتحقق من المسار الفعلي."

#. module: print_gateway
#: models/binding.py
msgid "POS order has no POS configuration for print routing."
msgstr "طلب POS لا يحتوي على إعداد POS لتوجيه الطباعة."

#. module: print_gateway
#: models/binding.py
msgid "Delivery has no operation type for print routing."
msgstr "التسليم لا يحتوي على نوع عملية لتوجيه الطباعة."

#. module: print_gateway
#: models/binding.py
msgid "A deterministic Odoo print destination is required."
msgstr "يلزم تحديد وجهة طباعة محددة في Odoo."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding no longer exists."
msgstr "ربط الطباعة المحدَّد صراحةً لم يعد موجودًا."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding is disabled."
msgstr "ربط الطباعة المحدَّد صراحةً معطَّل."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding is not scoped to the current company and branch."
msgstr "ربط الطباعة المحدَّد صراحةً نطاقه لا يغطي الشركة والفرع الحاليين."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding does not match this destination and document type."
msgstr "ربط الطباعة المحدَّد صراحةً لا يطابق هذه الوجهة وهذا النوع من المستندات."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding does not match this report action."
msgstr "ربط الطباعة المحدَّد صراحةً لا يطابق إجراء التقرير هذا."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding has no routable runtime and printer."
msgstr "ربط الطباعة المحدَّد صراحةً لا يحتوي على Agent وطابعة قابلين للتوجيه."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding does not support protocol '%s'."
msgstr "ربط الطباعة المحدَّد صراحةً لا يدعم البروتوكول '%s'."

#. module: print_gateway
#: models/binding.py
msgid "The explicitly selected print binding is not capable of document printing."
msgstr "ربط الطباعة المحدَّد صراحةً غير قادر على طباعة المستندات."

#. module: print_gateway
#: models/binding.py
msgid "Print document type is required."
msgstr "نوع مستند الطباعة مطلوب."

#. module: print_gateway
#: models/binding.py
msgid "Print destination belongs to another Odoo company/branch context."
msgstr "وجهة الطباعة تتبع سياق شركة/فرع آخر في Odoo."

#. module: print_gateway
#: models/binding.py
msgid "Sent silently to printer."
msgstr "تم الإرسال بصمت إلى الطابعة."

#. module: print_gateway
#: models/binding.py
msgid "This print operation is blocked by the current Gateway plan limit."
msgstr "عملية الطباعة هذه محجوبة بسبب حد خطة الـ Gateway الحالية."

#. module: print_gateway
#: models/gateway_config.py
msgid "another endpoint"
msgstr "نقطة نهاية أخرى"

#. module: print_gateway
#: models/gateway_config.py
msgid "The Gateway at %(url)s answered with a redirect (HTTP %(code)s%(location)s). Configure the final Gateway origin directly (usually the HTTPS URL) instead of an address that redirects."
msgstr "ردّ الـ Gateway على العنوان %(url)s بتحويل (HTTP %(code)s%(location)s). اضبط أصل الـ Gateway النهائي مباشرةً (عادةً عنوان HTTPS) بدلًا من عنوان يُجري تحويلًا."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway synchronization has not completed within %d minutes. The next automatic check will retry it."
msgstr "لم تكتمل مزامنة الـ Gateway خلال %d دقيقة. سيعيد الفحص التلقائي التالي المحاولة."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway URL is required."
msgstr "عنوان URL للـ Gateway مطلوب."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway URL is invalid."
msgstr "عنوان URL للـ Gateway غير صالح."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway URL must use HTTP or HTTPS and include a host, e.g. https://print.example.com or http://192.0.2.10:3000."
msgstr "يجب أن يستخدم عنوان URL للـ Gateway بروتوكول HTTP أو HTTPS وأن يتضمن اسم مضيف، مثل https://print.example.com أو http://192.0.2.10:3000."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway URL must use HTTPS."
msgstr "يجب أن يستخدم عنوان URL للـ Gateway بروتوكول HTTPS."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway URL must not contain credentials, query parameters, or fragments."
msgstr "يجب ألا يحتوي عنوان URL للـ Gateway على بيانات اعتماد أو معاملات استعلام أو أجزاء."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway URL must be the Gateway origin, without an API path (include the port when the Gateway does not listen on 80/443)."
msgstr "يجب أن يكون عنوان URL للـ Gateway هو أصل الـ Gateway بدون مسار API (مع ذكر المنفذ إذا كان الـ Gateway لا يستمع على 80/443)."

#. module: print_gateway
#: models/gateway_config.py
msgid "Enter the installation API key from your Yaseir Print Gateway account to connect this company."
msgstr "أدخل مفتاح API للتثبيت من حساب Yaseir Print Gateway لربط هذه الشركة."

#. module: print_gateway
#: models/gateway_config.py
msgid "The installation key is no longer active. Create or select a new key in Yaseir Print Gateway, then save it here."
msgstr "مفتاح التثبيت لم يعد نشطًا. أنشئ مفتاحًا جديدًا أو اختره في Yaseir Print Gateway، ثم احفظه هنا."

#. module: print_gateway
#: models/gateway_config.py
msgid "The Gateway could not be reached. Check the Gateway URL and network connection."
msgstr "تعذّر الوصول إلى الـ Gateway. تحقّق من عنوان URL للـ Gateway ومن الاتصال بالشبكة."

#. module: print_gateway
#: models/gateway_config.py
msgid "Your printing settings are being updated in the printing service."
msgstr "جارٍ تحديث إعدادات الطباعة في خدمة الطباعة."

#. module: print_gateway
#: models/gateway_config.py
msgid "The previous Gateway endpoint (%(url)s) could not be disabled: %(error)s Fix the previous endpoint or replace the Gateway key, then save again."
msgstr "تعذّر تعطيل نقطة نهاية الـ Gateway السابقة (%(url)s): %(error)s أصلح نقطة النهاية السابقة أو استبدل مفتاح الـ Gateway، ثم احفظ مرة أخرى."

#. module: print_gateway
#: models/gateway_config.py
msgid "Saving your current printing settings."
msgstr "جارٍ حفظ إعدادات الطباعة الحالية."

#. module: print_gateway
#: models/gateway_config.py
msgid "Printing is enabled and the service is connected."
msgstr "الطباعة مُفعّلة والخدمة متصلة."

#. module: print_gateway
#: models/gateway_config.py
msgid "Printing is disabled and the service is connected."
msgstr "الطباعة معطَّلة والخدمة متصلة."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway Configuration can only be created for parent companies, not branches (%s)."
msgstr "يمكن إنشاء إعداد الـ Gateway للشركات الأم فقط، لا للفروع (%s)."

#. module: print_gateway
#: models/gateway_config.py
msgid "Legacy Runtime Agent must be a non-empty Gateway agent ID."
msgstr "يجب أن يكون الـ Agent القديم معرّف Agent غير فارغ في الـ Gateway."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway credential protection is unavailable or invalid."
msgstr "حماية بيانات اعتماد الـ Gateway غير متاحة أو غير صالحة."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway API key is not configured."
msgstr "مفتاح API للـ Gateway غير مُعدّ."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway credential protection is unavailable or invalid. Configure the deployment-managed credential encryption key before using Gateway printing."
msgstr "حماية بيانات اعتماد الـ Gateway غير متاحة أو غير صالحة. اضبط مفتاح تشفير بيانات الاعتماد المُدار من النشر قبل استخدام طباعة الـ Gateway."

#. module: print_gateway
#: models/gateway_config.py
msgid "The Gateway workspace is not available for printing."
msgstr "مساحة عمل الـ Gateway غير متاحة للطباعة."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway health check failed (HTTP %s)."
msgstr "تعذّر فحص صحة الـ Gateway (HTTP %s)."

#. module: print_gateway
#: models/gateway_config.py
msgid "The previous Gateway rejected shutdown synchronization because its stored API key is unauthorized."
msgstr "رفض الـ Gateway السابق مزامنة الإيقاف لأن مفتاح API المخزَّن غير مصرَّح به."

#. module: print_gateway
#: models/gateway_config.py
msgid "The previous Gateway did not confirm that Odoo integration was disabled (HTTP %s)."
msgstr "لم يؤكد الـ Gateway السابق تعطيل تكامل Odoo (HTTP %s)."

#. module: print_gateway
#: models/gateway_config.py
msgid "The previous Gateway returned an invalid migration revision."
msgstr "أعاد الـ Gateway السابق رقم مراجعة ترحيل غير صالح."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway endpoint shutdown/migration state is incomplete; automatic reconciliation is blocked until it is repaired."
msgstr "حالة إيقاف/ترحيل نقطة نهاية الـ Gateway غير مكتملة؛ وتسوية الحالة تلقائيًا محجوبة إلى أن تُصلَح."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway activation synchronization was rejected because the API key is unauthorized."
msgstr "رُفضت مزامنة تفعيل الـ Gateway لأن مفتاح API غير مصرَّح به."

#. module: print_gateway
#: models/gateway_config.py
msgid "Gateway activation synchronization returned an invalid response."
msgstr "أعادت مزامنة تفعيل الـ Gateway استجابة غير صالحة."

#. module: print_gateway
#: models/gateway_config.py
msgid "The Gateway rejected the printing-service setting (HTTP %s). Check the Gateway URL and installation API key, then try again."
msgstr "رفض الـ Gateway إعداد خدمة الطباعة (HTTP %s). تحقّق من عنوان URL للـ Gateway ومن مفتاح API للتثبيت، ثم حاول مرة أخرى."

#. module: print_gateway
