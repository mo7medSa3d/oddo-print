<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_print_gateway_policy_list" model="ir.ui.view">
        <field name="name">print_gateway.policy.list</field>
        <field name="model">print_gateway.policy</field>
        <field name="arch" type="xml">
            <list string="Automation Rules" create="1" delete="1" class="o_pg_list">
                <field name="priority" widget="handle"/>
                <field name="name" string="Rule Name"/>
                <field name="company_id" string="Company" optional="hide" groups="base.group_multi_company"/>
                <field name="branch_id" string="Branch" placeholder="All Branches / Root Default"/>
                <field name="model_id" string="Record Type"/>
                <field name="event_type" string="When" widget="badge"/>
                <field name="action_type" widget="badge"/>
                <field name="report_id" string="Document" optional="show"/>
                <field name="binding_id" string="Print Rule" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_policy_form" model="ir.ui.view">
        <field name="name">print_gateway.policy.form</field>
        <field name="model">print_gateway.policy</field>
        <field name="arch" type="xml">
            <form string="Automation Rule" class="o_pg_view o_pg_form">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title mb-3">
                        <label for="name" string="Rule Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Auto-print delivery slip on validate" required="1"/>
                        </h1>
                        <div class="text-muted">Automatically print documents when a business event occurs.</div>
                    </div>

                    <group>
                        <group name="scope_trigger" string="When this happens">
                            <field name="company_id" domain="[('parent_id', '=', False)]" options="{'no_create': True}" groups="base.group_multi_company"/>
                            <field name="branch_id" domain="[('parent_id', '=', company_id)]" invisible="not company_id" placeholder="All Branches / Root Default" options="{'no_create': True}"/>
                            <field name="model_id" options="{'no_create': True}" required="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="event_type" required="1"/>
                            <field name="priority"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>

                        <group name="print_action" string="What to print">

                            <field name="action_type" widget="radio" options="{'horizontal': true}"/>
                            
                            <field name="report_id" 
                                   domain="[('model', '=', model_name)]" 
                                   options="{'no_create': True}" 
                                   invisible="action_type != 'report'" 
                                   required="action_type == 'report'"/>
                            
                            <field name="raw_protocol" 
                                   invisible="action_type != 'raw_template'" 
                                   required="action_type == 'raw_template'"/>
                            
                            <field name="binding_id"
                                   domain="[('company_id', '=', company_id), ('branch_id', '=', branch_id)]"
                                   options="{'no_create': True}"
                                   help="Optional explicit Print Rule for this exact Company and Branch scope."/>
                        </group>
                    </group>

                    <group string="Advanced Printer Command" invisible="action_type != 'raw_template'">
                        <field name="raw_template" nolabel="1" placeholder="e.g. ^XA^FO50,50^ADN,36,20^FD{name}^FS^XZ" class="font-monospace" style="min-height: 120px;"/>
                    </group>

                    <group string="Conditions">
                        <field name="warehouse_id" invisible="model_name != 'stock.picking'" options="{'no_create': True}"/>
                        <field name="picking_type_id" invisible="model_name != 'stock.picking'" options="{'no_create': True}"/>
                        <field name="domain_filter" widget="domain" options="{'model': 'model_name'}" placeholder="e.g. [('state', '=', 'done')]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_print_gateway_policies" model="ir.actions.act_window">
        <field name="name">Print Policies</field>
        <field name="res_model">print_gateway.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>