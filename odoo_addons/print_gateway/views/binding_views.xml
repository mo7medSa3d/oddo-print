<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_binding_list" model="ir.ui.view">
        <field name="name">print_gateway.binding.list</field>
        <field name="model">print_gateway.binding</field>
        <field name="arch" type="xml">
            <list string="Print Rules" create="1" delete="1" class="o_pg_list">
                <field name="company_id" string="Company" optional="hide"/>
                <field name="branch_id" string="Branch" placeholder="All Branches / Root Default" help="Empty means this binding applies to the whole company as the default route."/>
                <field name="effective_company_id" column_invisible="1"/>
                <field name="destination_type" string="Print Area" widget="badge" decoration-info="destination_type == 'pos'" decoration-success="destination_type == 'report'" decoration-warning="destination_type == 'picking_type'"/>
                <field name="destination_ref" string="Document / Destination"/>
                <field name="document_type" string="Document Type"/>
                <field name="runtime_agent_id" string="Print Agent" optional="show"/>
                <field name="printer_id" string="Printer"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="priority" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_binding_form" model="ir.ui.view">
        <field name="name">print_gateway.binding.form</field>
        <field name="model">print_gateway.binding</field>
        <field name="arch" type="xml">
            <form string="Print Rule" class="o_pg_view o_pg_form">
                <header>
                    <button name="action_send_test_print" type="object" string="Test Print" class="btn btn-primary" icon="fa-print" invisible="not runtime_agent_id or not printer_id"
                            confirm="A test receipt will be printed on the selected printer. Continue?"/>
                    <button name="action_verify_remote_hardware" type="object" string="Check Setup" class="btn btn-secondary" icon="fa-check-circle" invisible="not runtime_agent_id or not printer_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Print Rule</h1>
                        <p class="text-muted">Choose where each document should be printed.</p>
                    </div>

                    <separator string="Rule"/>
                    <div class="mb-3">
                        <field name="name" readonly="1"/>
                    </div>
                    <div class="text-muted mb-3"><small>Select the document, branch, and printer for this rule.</small></div>

                    <group string="Scope">
                        <field name="company_id" string="Company" domain="[('parent_id', '=', False)]" options="{'no_create': True}"/>
                        <field name="branch_id" string="Branch" domain="[('parent_id', '=', company_id)]"
                               invisible="not company_id" placeholder="All Branches / Root Default" options="{'no_create': True}" help="Empty means this binding applies to the whole company as the default route."/>
                    </group>

                    <group string="Document &amp; Destination">
                        <field name="destination_type" string="Print Area" widget="radio" options="{'horizontal': true}"/>
                        <field name="destination_pos_config_id" string="POS Shop"
                               invisible="destination_type != 'pos'" required="destination_type == 'pos'"
                               domain="['&amp;', '|', ('company_id', '=', False), ('company_id', '=', effective_company_id), ('active', '=', True)]"/>
                        <field name="destination_pos_printer_id" string="Kitchen Printer"
                               invisible="destination_type != 'pos_printer'" required="destination_type == 'pos_printer'"
                               domain="['|', ('company_id', '=', False), ('company_id', '=', effective_company_id)]"/>
                        <field name="destination_picking_type_id" string="Operation Type"
                               invisible="destination_type != 'picking_type'" required="destination_type == 'picking_type'"
                               domain="['&amp;', '|', ('company_id', '=', False), ('company_id', '=', effective_company_id), ('active', '=', True)]"/>
                        <field name="destination_report_id" string="Report"
                               invisible="destination_type != 'report'" required="destination_type == 'report'"/>
                        <field name="report_id" string="Document / Report"
                               invisible="destination_type == 'pos_printer'" required="destination_type != 'pos_printer'"/>
                        <field name="document_type" string="Document Type" readonly="1"/>
                    </group>

                    <group string="Printer Setup">
                        <field name="runtime_agent_id" string="Print Agent" widget="gateway_runtime_agent_binding"/>
                        <field name="printer_id" string="Runtime Printer" widget="gateway_runtime_printer"/>
                    </group>

                    <notebook>
                        <page string="Advanced">
                            <group>
                                <field name="printer_protocol" string="Printer Protocol"/>
                                <field name="fallback_binding_id" string="Backup Rule" options="{'no_create': True}"/>
                                <field name="enabled" widget="boolean_toggle"/>
                                <field name="priority"/>
                            </group>
                        </page>
                        <page string="Printer Options">
                            <group>
                                <field name="drawer_kick_mode" string="Cash Drawer"/>
                                <field name="cutter_mode" string="Paper Cutter"/>
                                <field name="buzzer_mode" string="Kitchen Chime"/>
                            </group>
                        </page>
                    </notebook>

                    <field name="effective_company_id" invisible="1"/>
                    <field name="destination_ref" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_binding" model="ir.actions.act_window">
        <field name="name">Print Gateway Bindings</field>
        <field name="res_model">print_gateway.binding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
