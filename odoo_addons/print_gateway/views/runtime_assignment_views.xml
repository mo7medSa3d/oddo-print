<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branch → Runtime Agent assignments. Written by the Pair Agent wizard
         or created additively when a binding names a runtime target. The
         assignment remains independent so removing one binding cannot silently
         remove the branch's other valid agent assignments. -->
    <record id="view_print_gateway_runtime_assignment_list" model="ir.ui.view">
        <field name="name">print_gateway.runtime_agent_assignment.list</field>
        <field name="model">print_gateway.runtime_agent_assignment</field>
        <field name="arch" type="xml">
            <list string="Branch Devices" class="o_pg_list">
                <field name="company_id" string="Company"/>
                <field name="branch_id" string="Branch"/>
                <field name="runtime_agent_id" string="Print Agent"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_runtime_assignment_form" model="ir.ui.view">
        <field name="name">print_gateway.runtime_agent_assignment.form</field>
        <field name="model">print_gateway.runtime_agent_assignment</field>
        <field name="arch" type="xml">
            <form string="Branch Device" class="o_pg_view o_pg_form">
                <sheet>
                    <div class="alert alert-info" role="alert">Choose which Print Agent serves this branch. A branch can use more than one agent.</div>
                    <group>
                        <field name="company_id" string="Company" options="{'no_create': True}"/>
                        <field name="branch_id" string="Branch" options="{'no_create': True}" help="Empty means this assignment applies to the whole company."/>
                        <field name="runtime_agent_id" string="Print Agent" widget="gateway_runtime_agent" help="Choose an active Print Agent connected to this account."/>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                    <group string="Details">
                        <field name="name" readonly="1" string="Summary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_runtime_assignments" model="ir.actions.act_window">
        <field name="name">Branch Agent Assignments</field>
        <field name="res_model">print_gateway.runtime_agent_assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
