<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_config_list" model="ir.ui.view">
        <field name="name">print_gateway.gateway_config.list</field>
        <field name="model">print_gateway.gateway_config</field>
        <field name="arch" type="xml">
            <list string="Gateway Configuration" create="1" class="o_pg_list">
                <field name="company_id" string="Odoo Company"/>
                <field name="gateway_sync_state"
                       string="Gateway Status"
                       widget="badge"
                       decoration-success="gateway_sync_state == 'active'"
                       decoration-warning="gateway_sync_state == 'syncing'"
                       decoration-danger="gateway_sync_state == 'attention'"
                       decoration-muted="gateway_sync_state in ('disabled', 'not_configured')"/>
                <field name="enabled" widget="boolean_toggle" string="Active"/>
                <field name="gateway_url"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_config_form" model="ir.ui.view">
        <field name="name">print_gateway.gateway_config.form</field>
        <field name="model">print_gateway.gateway_config</field>
        <field name="arch" type="xml">
            <form string="Gateway Configuration" create="1" class="o_pg_view o_pg_form">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                    <button name="action_open_pairing_wizard" type="object" string="Pair New Agent" class="btn-primary" icon="fa-link"/>
                    <button name="action_open_runtime_assignments" type="object" string="Branch Assignments" icon="fa-sitemap"/>
                </header>
                <sheet>
                    <div class="o_pg_record_header">
                        <span class="o_pg_record_icon"><i class="fa fa-plug" role="img" aria-label="Gateway"/></span>
                        <div>
                            <h1>Print Gateway</h1>
                            <p class="text-muted mb-0">Odoo owns business context and print intent. Gateway owns runtime Agents, runtime Printers, queueing and execution.</p>
                        </div>
                    </div>

                    <!-- Distinct State Row: Credential / Activation / Connection -->
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <!-- Credential State -->
                        <div class="o_pg_cred_card flex-fill" t-att-class="('has-key' if gateway_api_key else 'no-key')">
                            <span class="o_pg_cred_icon"><i class="fa fa-key" role="img" aria-label="Credential"/></span>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">Credential</div>
                                <div class="small text-muted">
                                    <span t-if="gateway_api_key">API key configured • Encrypted at rest</span>
                                    <span t-if="not gateway_api_key">No API key • Setup required</span>
                                </div>
                            </div>
                            <span t-if="gateway_api_key" class="badge text-bg-success">Present</span>
                            <span t-if="not gateway_api_key" class="badge text-bg-danger">Missing</span>
                        </div>
                        <!-- Activation State -->
                        <div class="o_pg_cred_card flex-fill" t-att-class="('has-key' if enabled else '')">
                            <span class="o_pg_cred_icon"><i class="fa fa-power-off" role="img" aria-label="Activation"/></span>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">Activation</div>
                                <div class="small text-muted">
                                    <span t-if="enabled">Printing enabled in Odoo</span>
                                    <span t-if="not enabled">Printing disabled in Odoo</span>
                                </div>
                            </div>
                            <span t-if="enabled" class="o_pg_activation_state enabled">Enabled</span>
                            <span t-if="not enabled" class="o_pg_activation_state disabled">Disabled</span>
                        </div>
                        <!-- Connection State -->
                        <div class="o_pg_connection_banner flex-fill mb-0" t-attf-class="o_pg_connection_banner flex-fill mb-0 is-{{gateway_sync_state}}">
                            <span class="o_pg_conn_icon">
                                <i t-if="gateway_sync_state == 'active'" class="fa fa-check" role="img" aria-label="Active"/>
                                <i t-if="gateway_sync_state == 'syncing'" class="fa fa-refresh fa-spin" role="img" aria-label="Syncing"/>
                                <i t-if="gateway_sync_state == 'attention'" class="fa fa-exclamation-triangle" role="img" aria-label="Attention"/>
                                <i t-if="gateway_sync_state in ('disabled','not_configured')" class="fa fa-pause" role="img" aria-label="Inactive"/>
                            </span>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">
                                    <field name="gateway_sync_state" readonly="1" nolabel="1" class="d-inline"/>
                                </div>
                                <div class="small"><field name="gateway_sync_message" readonly="1" nolabel="1"/></div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="gateway_sync_state != 'attention'">
                        <field name="gateway_sync_message" readonly="1" nolabel="1" class="fw-semibold"/>
                    </div>

                    <group>
                        <field name="company_id" string="Odoo Company"/>
                        <field name="enabled" widget="boolean_toggle" string="Enable Gateway Printing"/>
                        <field name="gateway_sync_state"
                               string="Connection Status"
                               widget="badge"
                               decoration-success="gateway_sync_state == 'active'"
                               decoration-warning="gateway_sync_state == 'syncing'"
                               decoration-danger="gateway_sync_state == 'attention'"
                               decoration-muted="gateway_sync_state in ('disabled', 'not_configured')"/>
                    </group>
                    <div class="oe_inline text-muted mb-3">
                        <field name="gateway_sync_message" readonly="1" nolabel="1"/>
                    </div>
                    <group string="Connection">
                        <field name="gateway_url" placeholder="https://print.example.com"/>
                        <field name="gateway_api_key" password="True" placeholder="Paste the installation API key"/>
                        <button name="action_clear_api_key"
                                type="object"
                                string="Remove API Key"
                                class="btn btn-outline-danger btn-sm"
                                groups="base.group_system"
                                invisible="not gateway_api_key"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_config" model="ir.actions.act_window">
        <field name="name">Gateway Configuration</field>
        <field name="res_model">print_gateway.gateway_config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_print_gateway_pair_agent_wizard_form" model="ir.ui.view">
        <field name="name">print_gateway.pair_agent_wizard.form</field>
        <field name="model">print_gateway.pair_agent_wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Runtime Agent" class="o_pg_view o_pg_pairing_wizard">
                <sheet>
                    <div class="o_pg_wizard_header text-center mb-4">
                        <i class="fa fa-plug fa-3x text-primary mb-2" title="Assign Agent" role="img" aria-label="Assign Agent"/>
                        <h3 class="fw-bold">Assign Runtime Agent</h3>
                        <p class="text-muted">Select the target Branch, then enter the ID of an active Gateway Agent. Multiple Agents can be assigned to the same Branch.</p>
                    </div>
                    <group>
                        <field name="config_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="branch_id" string="Target Branch" options="{'no_create': True, 'no_open': True}"/>
                        <field name="agent_id" string="Runtime Agent ID" placeholder="e.g. agent-pos-01" class="o_pg_pairing_code_input text-center fw-bold fs-4" required="1" help="ID of an active agent as shown on the Gateway Agents page."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_pairing" string="Assign Agent" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
