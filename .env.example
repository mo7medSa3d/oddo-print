# Gateway runtime configuration example. Replace every placeholder before production use.
# Lines marked [required in production] refuse startup when missing/placeholder.
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/print_gateway
GATEWAY_JWT_SECRET=  # [required in production] >= 32 chars, not a documented placeholder
APP_BASE_URL=http://localhost:3000  # [required in production] clean https:// origin, e.g. https://print.example.com
TRUST_PROXY=0  # [required in production] set 1 behind the Caddy reverse proxy (non-loopback binds refuse startup otherwise)
TRUST_PROXY_SECRET=  # [required in production] >= 32 chars; Caddy injects it via X-Gateway-Proxy-Token
COOKIE_SECURE=1  # [required in production] must not be 0/false/no/off; use 0 only for local HTTP development
DESKTOP_CORS_ORIGINS=
# Platform control plane:
PLATFORM_TENANT_ID=<required-platform-tenant-id>  # [required in production] real platform workspace ID
# Manager authentication:
MANAGER_USERNAME=admin
# MANAGER_TENANT_ID=  # Single-tenant bootstrap: pins manager login to one tenant (see OPERATIONS.md)
# MANAGER_PASSWORD_HASH=  # Argon2id hash for production; set ALLOW_PLAINTEXT_MANAGER_PASSWORD=1 for dev only
# ALLOW_PLAINTEXT_MANAGER_PASSWORD=1  # NEVER use in production
# Agent presence:
# STALE_AGENT_THRESHOLD_SECONDS=90
# AGENT_PRESENCE_SWEEP_LIMIT=200  # stale-Agent persistence batch per tick, capped at 5000

# Runtime/internal controls:
# LOG_LEVEL=info  # debug|info|warn|error; default is debug in development, info otherwise
# ALLOW_HOST_FALLBACK=1  # NEVER in production: derive email/Stripe URLs from Host when APP_BASE_URL is unset (local HTTP dev only)
# ALLOW_LEGACY_MANAGER_AUTH=0
# ALLOW_PLATFORM_BOOTSTRAP_FORCE=0
# MAINTENANCE_SWEEP_LIMIT=100
# JOB_RETENTION_SWEEP_LIMIT=500  # terminal print-job retention cleanup batch (max 5000); distinct from MAINTENANCE_SWEEP_LIMIT above
# WS_ALLOWED_ORIGINS=
# MANAGER_PASSWORD=  # Prefer MANAGER_PASSWORD_HASH outside development/test
#
# PostgreSQL connection components (only when not using DATABASE_URL):
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=odoo_print
# PGPASSWORD=
# PGDATABASE=yasser_db
#
# Platform-owner bootstrap:
# PLATFORM_OWNER_EMAIL=
# PLATFORM_OWNER_PASSWORD=
# PLATFORM_OWNER_PASSWORD_FILE=

# Optional billing/email integration:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_API_VERSION=
# STRIPE_PLAN_CATALOG=
# RESEND_API_KEY=
# EMAIL_FROM=

# Platform operations:
# YASEIR_DEPLOYMENT_ID=  # Nonsecret immutable release SHA; same value at Docker build + runtime (see SERVER_FIRST_RUN.md)
# GATEWAY_DOMAIN=print.example.com
# GATEWAY_HTTP_PORT=80
# GATEWAY_HTTPS_PORT=443
# POSTGRES_DB=yasser_db
# POSTGRES_USER=odoo_print
# POSTGRES_PASSWORD=

# Agent development:
# YASEIR_AGENT_ALLOW_INSECURE_HTTP=1
# YASEIR_AGENT_ALLOW_PROXY=1  # honor HTTP(S)_PROXY for Gateway control-plane traffic (default: direct, no proxy)
