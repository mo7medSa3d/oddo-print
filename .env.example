# Gateway runtime configuration example. Replace every placeholder before production use.
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/print_gateway
GATEWAY_JWT_SECRET=
APP_BASE_URL=http://localhost:3000
TRUST_PROXY=0
TRUST_PROXY_SECRET=
COOKIE_SECURE=0
DESKTOP_CORS_ORIGINS=
# Platform control plane:
PLATFORM_TENANT_ID=<required-platform-tenant-id>
# Manager authentication:
MANAGER_USERNAME=admin
# MANAGER_TENANT_ID=  # Single-tenant bootstrap: pins manager login to one tenant (see OPERATIONS.md)
# MANAGER_PASSWORD_HASH=  # Argon2id hash for production; set ALLOW_PLAINTEXT_MANAGER_PASSWORD=1 for dev only
# ALLOW_PLAINTEXT_MANAGER_PASSWORD=1  # NEVER use in production
# Agent presence:
# STALE_AGENT_THRESHOLD_SECONDS=90
# AGENT_PRESENCE_SWEEP_LIMIT=200  # stale-Agent persistence batch per tick, capped at 5000

# Runtime/internal controls:
# ALLOW_LEGACY_MANAGER_AUTH=0
# ALLOW_PLATFORM_BOOTSTRAP_FORCE=0
# MAINTENANCE_SWEEP_LIMIT=100
# JOB_RETENTION_SWEEP_LIMIT=500  # terminal print-job retention cleanup batch (max 5000); distinct from MAINTENANCE_SWEEP_LIMIT above
# WS_ALLOWED_ORIGINS=
# MANAGER_PASSWORD=  # Prefer MANAGER_PASSWORD_HASH outside development/test
#
# PostgreSQL connection components (only when not using DATABASE_URL):
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=odoo_print
# PGPASSWORD=
# PGDATABASE=yasser_db
#
# Platform-owner bootstrap:
# PLATFORM_OWNER_EMAIL=
# PLATFORM_OWNER_PASSWORD=
# PLATFORM_OWNER_PASSWORD_FILE=

# Optional billing/email integration:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_API_VERSION=
# STRIPE_PLAN_CATALOG=
# RESEND_API_KEY=
# EMAIL_FROM=

# Platform operations:
# GATEWAY_DOMAIN=print.example.com
# GATEWAY_HTTP_PORT=80
# GATEWAY_HTTPS_PORT=443
# POSTGRES_DB=yasser_db
# POSTGRES_USER=odoo_print
# POSTGRES_PASSWORD=

# Agent development:
# YASEIR_AGENT_ALLOW_INSECURE_HTTP=1
