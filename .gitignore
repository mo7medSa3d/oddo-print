.audit/
graphify-out/
.vitest/

# tauri-build generates command permissions from build.rs on each native build.
/src-tauri/permissions/autogenerated/
# Drizzle generation may recreate this redundant numeric alias. The canonical
# 0091_workspace_session_security_snapshot.json is the versioned metadata.
/drizzle/meta/0091_snapshot.json
