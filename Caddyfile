{$GATEWAY_DOMAIN} {
	encode gzip zstd

	request_body {
		max_size 8MiB
	}

	# The Gateway trusts forwarded client identity only after verifying the
	# private proxy token. Caddy's reverse_proxy sanitizes X-Forwarded-* inputs
	# by default, ignoring client-supplied forwarding values before forwarding.
	reverse_proxy gateway:3000 {
		header_up X-Gateway-Proxy-Token {file./run/secrets/trust_proxy_secret}
		header_up -X-Real-Ip
	}
}
