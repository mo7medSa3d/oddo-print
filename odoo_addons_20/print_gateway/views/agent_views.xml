<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_agent_list" model="ir.ui.view">
        <field name="name">print_gateway.agent.list</field>
        <field name="model">print_gateway.agent</field>
        <field name="arch" type="xml">
            <list string="Direct Print Agents" class="o_pg_list">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="status" widget="badge" decoration-success="status == 'online'" decoration-muted="status == 'offline'"/>
                <field name="last_seen_at"/>
                <field name="agent_uid" class="o_pg_mono" optional="show"/>
                <field name="agent_version" class="o_pg_mono" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_agent_form" model="ir.ui.view">
        <field name="name">print_gateway.agent.form</field>
        <field name="model">print_gateway.agent</field>
        <field name="arch" type="xml">
            <form string="Direct Print Agent" class="o_pg_view o_pg_form">
                <header>
                    <button name="action_generate_pairing_code" type="object" string="Generate Pairing Code" class="btn-primary" groups="base.group_system"/>
                    <button name="action_revoke_disconnect" type="object" string="Revoke &amp; Disconnect" class="btn-secondary" groups="base.group_system" confirm="Disconnect this agent and revoke its token? Its printers will be unshared until re-paired."/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="agent_uid" readonly="1" class="o_pg_mono"/>
                            <field name="agent_version" readonly="1" class="o_pg_mono"/>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="pairing_expires_at" readonly="1" groups="base.group_system" invisible="not pairing_expires_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Printers">
                            <field name="printer_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="capability_summary"/>
                                    <field name="is_virtual" optional="show"/>
                                    <field name="status" widget="badge" decoration-success="status == 'online'" decoration-warning="status == 'busy'" decoration-danger="status == 'error'" decoration-muted="status in ('offline', 'unknown')"/>
                                    <field name="available_to_odoo"/>
                                    <field name="last_seen_at" optional="show"/>
                                    <field name="printer_key" class="o_pg_mono" optional="hide"/>
                                    <field name="protocol" optional="hide"/>
                                    <field name="connection_type" optional="hide"/>
                                    <field name="paper_width_mm" optional="hide"/>
                                    <field name="dots_per_line" optional="hide"/>
                                    <field name="dpi" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_agents" model="ir.actions.act_window">
        <field name="name">Direct Print Agents</field>
        <field name="res_model">print_gateway.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
