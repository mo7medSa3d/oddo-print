<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_job_search" model="ir.ui.view">
        <field name="name">print_gateway.print_job.search</field>
        <field name="model">print_gateway.print_job</field>
        <field name="arch" type="xml">
            <search string="Search Print Activity">
                <field name="idempotency_key" string="Reference"/>
                <field name="printer_id" string="Printer"/>
                <field name="destination" string="Destination"/>

                <filter name="filter_attention" string="Needs Review - Output May Be Uncertain" domain="[('status', '=', 'unknown')]"/>
                <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_canceled" string="Canceled" domain="[('status', '=', 'canceled')]"/>
                <filter name="filter_active" string="In Progress" domain="[('status', 'in', ['queued', 'claimed', 'printing'])]"/>
                <filter name="filter_success" string="Sent for printing" domain="[('status', '=', 'success')]"/>

                <separator/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_destination" string="Destination" context="{'group_by': 'destination'}"/>
                    <filter name="group_printer" string="Printer" context="{'group_by': 'printer_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_print_gateway_job_list" model="ir.ui.view">
        <field name="name">print_gateway.print_job.list</field>
        <field name="model">print_gateway.print_job</field>
        <field name="arch" type="xml">
            <list string="Print Activity" create="0" delete="0" class="o_pg_list">
                <field name="create_date" string="Created"/>
                <field name="company_id" optional="hide"/>
                <field name="destination" string="Destination"/>
                <field name="document_type" string="Document" optional="show"/>
                <field name="printer_id" string="Printer" class="o_pg_mono"/>
                <field name="status" column_invisible="1"/>
                <field name="customer_status" widget="badge" decoration-danger="customer_status == 'failed_before_output'" decoration-warning="customer_status == 'needs_review'" decoration-info="customer_status in ('waiting', 'processing', 'sent_to_printer')"/>
                <field name="output_medium" optional="hide"/>
                <field name="physical_outcome" optional="hide" widget="badge" decoration-danger="physical_outcome == 'not_printed'" decoration-warning="physical_outcome == 'unknown'" decoration-success="physical_outcome == 'printed'"/>
                <field name="attempts" optional="hide"/>
                <field name="reprint_attempt_count" optional="hide" string="Reprints"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_job_form" model="ir.ui.view">
        <field name="name">print_gateway.print_job.form</field>
        <field name="model">print_gateway.print_job</field>
        <field name="arch" type="xml">
            <form string="Print Activity" create="0" delete="0" class="o_pg_view o_pg_form">
                <header>
                    <button name="action_force_reprint" type="object" string="Reprint" class="btn-warning" groups="base.group_system"
                            confirm="Reprint this document only after checking the printer. This creates a new print attempt."
                            invisible="status not in ('unknown', 'failed', 'canceled') or (status == 'failed' and physical_outcome != 'unknown') or (status == 'canceled' and physical_outcome != 'unknown')"/>
                    <button name="action_retry" type="object" string="Retry Print" class="oe_highlight" groups="base.group_system" invisible="status != 'failed' or physical_outcome != 'not_printed'"/>
                    <field name="status" invisible="1"/>
                    <field name="customer_status" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- Amber Callout for UNKNOWN_PARTIAL_DELIVERY -->
                    <div class="o_pg_unknown_alert" role="alert" aria-live="polite" invisible="status not in ('unknown',)">
                        <div class="o_pg_unknown_content">
                            <span class="o_pg_unknown_icon"><span class="material-symbols-rounded" role="img" aria-label="Warning" t-translation="on">warning</span></span>
                            <div>
                                <h4>Print status is unknown - the printer may have received part or all of the document</h4>
                                <p>Automatic retry is paused to prevent duplicate printing. Check the printer before choosing Reprint.</p>
                            </div>
                        </div>
                    </div>

                    <div class="o_pg_record_header">
                        <span class="o_pg_record_icon"><span class="material-symbols-rounded" role="img" aria-label="Print job" t-translation="on">print</span></span>
                        <div>
                            <h1><field name="destination" readonly="1"/></h1>
                            <p class="text-muted mb-0" dir="ltr"><field name="idempotency_key" readonly="1" class="o_pg_mono"/></p>
                        </div>
                    </div>

                    <group>
                        <group string="Print Details">
                            <field name="company_id" readonly="1"/>
                            <field name="document_type" readonly="1"/>
                            <field name="printer_id" readonly="1" class="o_pg_mono"/>
                            <field name="output_medium" readonly="1"/>
                            <field name="physical_outcome" readonly="1" widget="badge" decoration-danger="physical_outcome == 'not_printed'" decoration-warning="physical_outcome == 'unknown'" decoration-success="physical_outcome == 'printed'"/>
                        </group>
                        <group string="Delivery details" groups="base.group_system">
                            <field name="attempts" readonly="1"/>
                            <field name="reprint_attempt_count" readonly="1" invisible="reprint_attempt_count == 0"/>
                            <field name="next_retry_at" readonly="1"/>
                            <field name="completed_at" readonly="1" invisible="not completed_at"/>
                        </group>
                    </group>

                    <group string="Issue Details" invisible="not last_error">
                        <field name="last_error" invisible="1"/>
                        <field name="customer_issue" readonly="1" nolabel="1"/>
                    </group>

                    <group string="Document" invisible="not source_model">
                        <field name="source_model" readonly="1"/>
                        <field name="source_record_id" readonly="1"/>
                        <field name="report_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_jobs" model="ir.actions.act_window">
        <field name="name">Print Activity</field>
        <field name="res_model">print_gateway.print_job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_print_gateway_job_search"/>
        <field name="context">{'search_default_filter_active': 0}</field>
    </record>
</odoo>
