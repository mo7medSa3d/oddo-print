#. module: print_gateway
#: model:ir.module.module,description:base.module_print_gateway
msgid "\nConnect Odoo to Yaseir once per company.\n\nAssign a printing computer to each company or branch. Select a printer\nfor each print source under Print Routing. Enable automatic printing\nonly when the relevant print rules are ready.\n\nComputer assignments are managed in one place. Selecting a printer does not\ncreate an agent assignment or send a print job.\n    "
msgstr "\nاربط أودو بـ Yaseir مرة واحدة لكل شركة.\n\nعيّن جهاز طباعة لكل شركة أو فرع. اختر طابعة لكل مصدر طباعة ضمن «توجيه الطباعة». فعّل الطباعة التلقائية فقط عندما تكون قواعد الطباعة المعنية جاهزة.\n\nتُدار تعيينات أجهزة الطباعة من مكان واحد. اختيار طابعة لا ينشئ تعيينًا للـ Agent ولا يرسل مهمة طباعة.\n    "

#. module: print_gateway
#. odoo-python
#: code:addons/print_gateway/models/print_intent.py:0
msgid "%d failed intent(s) re-armed for immediate dispatch."
msgstr "تمت إعادة تجهيز %d طلب/طلبات فاشلة للإرسال الفوري."

