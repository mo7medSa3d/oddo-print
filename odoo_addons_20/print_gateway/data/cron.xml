<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_cleanup_terminal_gateway_print_jobs" model="ir.cron">
        <field name="name">Direct Odoo: Clean Terminal Print Jobs</field>
        <field name="model_id" ref="model_print_gateway_print_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_terminal_jobs()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="cron_recover_pending_gateway_intents" model="ir.cron">
        <field name="name">Direct Odoo: Recover Pending Print Intents</field>
        <field name="model_id" ref="model_print_gateway_intent"/>
        <field name="state">code</field>
        <field name="code">model.cron_recover_pending_intents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="cron_sweep_stale_direct_agents" model="ir.cron">
        <field name="name">Direct Odoo: Mark Stale Print Agents Offline</field>
        <field name="model_id" ref="model_print_gateway_agent"/>
        <field name="state">code</field>
        <field name="code">model._cron_sweep_stale_agents()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="cron_refresh_external_license_bundle" model="ir.cron">
        <field name="name">Yaseir Cloud: Refresh Signed Licence</field>
        <field name="model_id" ref="model_print_gateway_gateway_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_license_bundle()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
