{
  "name": "yasser-gateway",
  "version": "1.0.0",
  "description": "Yasser — Cloud Printing Platform (Next.js + PostgreSQL + Drizzle), Windows Go agent, and Tauri desktop manager",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "start": "NODE_ENV=production tsx server.ts",
    "start:next": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:studio": "drizzle-kit studio",
    "desktop:vite:build": "vite build --config vite.desktop.config.mts",
    "desktop:build": "npm run desktop:vite:build && pwsh -File scripts/build-windows-installer.ps1",
    "desktop:dev": "vite --config vite.desktop.config.mts",
    "desktop:linux:deps": "bash scripts/setup-tauri-linux.sh --check",
    "desktop:linux:deps:install": "bash scripts/setup-tauri-linux.sh --install",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "vitest run --config vitest.integration.config.mts --run tests/e2e-job-flow.test.ts",
    "test:odoo:static": "pytest tests/test_odoo19_printing_static.py",
    "build": "next build --webpack",
    "db:provision-plans": "tsx scripts/provision-plans.ts",
    "platform:bootstrap": "tsx scripts/bootstrap-platform-owner.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "ws": "8.21.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.4",
    "@types/pg": "8.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "5.0.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
