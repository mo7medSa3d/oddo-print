# HTTPS domain staging configuration for the test branch.
POSTGRES_DB=yasser_http_test
POSTGRES_USER=yasser_test
POSTGRES_PASSWORD=generated-at-setup
GATEWAY_JWT_SECRET=generated-at-setup
TRUST_PROXY_SECRET=generated-at-setup
PLATFORM_TENANT_ID=http-test-platform
MANAGER_USERNAME=http-test-admin
MANAGER_PASSWORD_HASH=unused-in-http-test-mode
GATEWAY_DOMAIN=print.yaseir.cloud
APP_BASE_URL=https://print.yaseir.cloud
COOKIE_SECURE=1
TRUST_PROXY=1
YASEIR_HTTP_TEST_MODE=1
HTTP_TEST_VOLUME_NAME=http-test_postgres_http_test_data
STRIPE_PLAN_CATALOG=[{"id":"http-test","name":"HTTP Test","priceId":"price_http_test_yasser","currency":"usd","interval":"month","entitlements":{"max_agents":5,"max_printers":10,"max_jobs_per_minute":60,"max_concurrent_jobs":8,"max_prints_per_period":"unlimited"}}]
